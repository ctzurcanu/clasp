(load "/Users/christiantzurcanu/Documents/dev/clasp/rlasp/coverage/os_command_coverage/common/assert.lisp")

(oscov-note "ffi_syscalls")

(let ((p (%foreign-alloc 32)))
  (%mem-set p :int 7 0)
  (%mem-set p :int64 123456789 8)
  (%mem-set p :double 3.5 16)
  (%mem-set p :byte 255 24)
  (oscov-assert-equal 7 (%mem-ref p :int 0) "%mem-ref :int")
  (oscov-assert-equal 123456789 (%mem-ref p :int64 8) "%mem-ref :int64")
  (oscov-assert-equal 3.5 (%mem-ref p :double 16) "%mem-ref :double")
  (oscov-assert-equal 255 (%mem-ref p :byte 24) "%mem-ref :byte")
  (%foreign-free p))

(oscov-assert (integerp (%foreign-funcall "getpid" :int)) "foreign getpid")
(oscov-assert-equal 6 (%foreign-funcall "strlen" :string "abcdef" :int) "foreign strlen")

(let* ((dir "/tmp/irlasp-oscov/ffi/")
       (path (concatenate 'string dir "read.txt"))
       (buf (%foreign-alloc 64)))
  (ensure-directories-exist dir)
  (with-open-file (out path :direction :output :if-exists :supersede :if-does-not-exist :create)
    (write-line "hello-ffi" out))
  (let ((fd (%foreign-funcall "open" :string path :int 0 :int)))
    (oscov-assert (>= fd 0) "foreign open should return non-negative fd")
    (let ((n (%foreign-funcall "read" :int fd :pointer buf :int 64 :int)))
      (oscov-assert (> n 0) "foreign read should read bytes")
      (oscov-assert-equal 104 (%mem-ref buf :byte 0) "foreign read first byte should be 'h'"))
    (oscov-assert-equal 0 (%foreign-funcall "close" :int fd :int) "foreign close should succeed"))
  (%foreign-free buf)
  (delete-file path))

(let* ((len 4096)
       (ptr (%foreign-funcall "mmap" :pointer 0 :long len :int 3 :int 4098 :int -1 :long 0 :pointer)))
  (oscov-assert ptr "foreign mmap should return pointer object")
  (oscov-assert (integerp (%foreign-funcall "mprotect" :pointer ptr :long len :int 1 :int)) "foreign mprotect should return integer")
  (oscov-assert (integerp (%foreign-funcall "msync" :pointer ptr :long len :int 0 :int)) "foreign msync should return integer")
  (oscov-assert (integerp (%foreign-funcall "munmap" :pointer ptr :long len :int)) "foreign munmap should return integer"))

(let ((pid (%foreign-funcall "getpid" :int)))
  (oscov-assert (integerp (%foreign-funcall "signal" :int 13 :symbol "SIG_DFL" :int)) "foreign signal should return integer")
  (oscov-assert (integerp (%foreign-funcall "sigaction" :int 13 :symbol "SIG_DFL" :int)) "foreign sigaction should return integer")
  (oscov-assert (integerp (%foreign-funcall "raise" :int 0 :int)) "foreign raise should return integer")
  (oscov-assert (integerp (%foreign-funcall "kill" :int pid :int 0 :int)) "foreign kill(pid,0) should return integer")
  (oscov-assert (integerp (%foreign-funcall "ptrace" :int 0 :int 0 :pointer 0 :int 0 :long)) "foreign ptrace should return integer"))

(format t "OK ffi_syscalls~%")
