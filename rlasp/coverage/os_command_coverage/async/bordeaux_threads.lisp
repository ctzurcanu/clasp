(load "/Users/christiantzurcanu/Documents/dev/clasp/rlasp/coverage/os_command_coverage/common/assert.lisp")

(oscov-note "bordeaux_threads")

(let ((self (bordeaux-threads:current-thread))
      (threads (bordeaux-threads:all-threads)))
  (oscov-assert self "bordeaux-threads:current-thread should return a thread designator")
  (oscov-assert (or (null threads) (consp threads)) "bordeaux-threads:all-threads should return list or NIL"))

(oscov-assert (null (bordeaux-threads:thread-yield))
              "bordeaux-threads:thread-yield should return NIL")

(let ((th (bordeaux-threads:make-thread (lambda () 42) :name "oscov-bt-worker")))
  (oscov-assert th "bordeaux-threads:make-thread should return thread designator")
  (oscov-assert (bordeaux-threads:thread-alive-p th) "thread should be alive before join")
  (let ((nm (bordeaux-threads:thread-name th)))
    (oscov-assert (or (stringp nm) (symbolp nm)) "bordeaux-threads:thread-name should return name designator"))
  (oscov-assert-equal 42 (bordeaux-threads:join-thread th) "bordeaux-threads:join-thread should return thread value")
  (oscov-assert (null (bordeaux-threads:thread-alive-p th)) "thread should not be alive after join"))

(let ((th (bordeaux-threads:make-thread (lambda () 17) :name "oscov-bt-interrupt")))
  (oscov-assert (bordeaux-threads:interrupt-thread th (lambda () nil))
                "bordeaux-threads:interrupt-thread should return truthy")
  (oscov-assert-equal 17 (bordeaux-threads:join-thread th)
                      "interrupt-thread should not break join result in simple case"))

(let ((th (bordeaux-threads:make-thread (lambda () 99) :name "oscov-bt-destroy")))
  (oscov-assert (bordeaux-threads:destroy-thread th)
                "bordeaux-threads:destroy-thread should return truthy")
  (oscov-assert (null (bordeaux-threads:thread-alive-p th))
                "destroy-thread should make thread inactive"))

(let ((lk (bordeaux-threads:make-lock :name "oscov-bt-lock")))
  (oscov-assert lk "bordeaux-threads:make-lock should return lock")
  (oscov-assert (bordeaux-threads:acquire-lock lk) "bordeaux-threads:acquire-lock should acquire lock")
  (oscov-assert (bordeaux-threads:release-lock lk) "bordeaux-threads:release-lock should release lock")
  (oscov-assert (eq :BT-LOCKED (bordeaux-threads:with-lock-held (lk) :BT-LOCKED))
                "bordeaux-threads:with-lock-held should execute body"))

(let ((rlk (bordeaux-threads:make-recursive-lock "oscov-bt-rec-lock")))
  (oscov-assert rlk "bordeaux-threads:make-recursive-lock should return lock")
  (oscov-assert (bordeaux-threads:acquire-lock rlk) "recursive lock first acquire")
  (oscov-assert (bordeaux-threads:acquire-lock rlk) "recursive lock second acquire")
  (oscov-assert (bordeaux-threads:release-lock rlk) "recursive lock first release")
  (oscov-assert (bordeaux-threads:release-lock rlk) "recursive lock second release"))

(let ((lk (bordeaux-threads:make-lock :name "oscov-bt-cv-lock"))
      (cv (bordeaux-threads:make-condition-variable :name "oscov-bt-cv")))
  (oscov-assert lk "bordeaux-threads:make-lock for condvar should return lock")
  (oscov-assert cv "bordeaux-threads:make-condition-variable should return condvar")
  (oscov-assert (bordeaux-threads:acquire-lock lk) "acquire condvar lock")
  (oscov-assert (bordeaux-threads:condition-notify cv) "condition-notify should return truthy")
  (oscov-assert (bordeaux-threads:condition-wait cv lk :timeout 0)
                "condition-wait should return truthy after notify")
  (oscov-assert (null (bordeaux-threads:condition-wait cv lk :timeout 0))
                "condition-wait should return NIL on timeout/no signal")
  (oscov-assert (bordeaux-threads:condition-broadcast cv) "condition-broadcast should return truthy")
  (oscov-assert (bordeaux-threads:release-lock lk) "release condvar lock"))

(let ((sem (bordeaux-threads:make-semaphore :count 1 :name "oscov-bt-sem")))
  (oscov-assert sem "bordeaux-threads:make-semaphore should return semaphore")
  (oscov-assert (bordeaux-threads:wait-on-semaphore sem :timeout 0)
                "wait-on-semaphore should acquire when count > 0")
  (oscov-assert (null (bordeaux-threads:wait-on-semaphore sem :timeout 0))
                "wait-on-semaphore should return NIL when count is 0")
  (oscov-assert (bordeaux-threads:signal-semaphore sem)
                "signal-semaphore should return truthy")
  (oscov-assert (bordeaux-threads:wait-on-semaphore sem :timeout 0)
                "wait-on-semaphore should acquire after signal"))

(format t "OK bordeaux_threads~%")
