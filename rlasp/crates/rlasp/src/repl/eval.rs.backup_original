fn eval_last(args: &[ASTNode], env: &mut HashMap<String, EvalResult>) -> Result<EvalResult, String> {
    if args.len() != 1 {
        return Err("last requires 1 argument".to_string());
    }

    let list = eval_with_env(&args[0], env)?;

    // Find the last cons cell
    let mut current = list.clone();

    loop {
        match &current {
            EvalResult::Nil => return Ok(EvalResult::Nil),
            EvalResult::Cons(_, cdr) => {
                let cdr_val = cdr.borrow().clone();
                match &cdr_val {
                    EvalResult::Nil => return Ok(current.clone()),
                    EvalResult::Cons(_, _) => {
                        current = cdr_val;
                    },
                    _ => return Ok(current.clone()), // Improper list
                }
            }
            _ => return Err("last requires a list".to_string()),
        }
    }
}

fn eval_list(args: &[ASTNode], env: &mut HashMap<String, EvalResult>) -> Result<EvalResult, String> {
    if args.is_empty() {
        return Ok(EvalResult::Nil);
    }

    // Evaluate all arguments and build a list from right to left
    let mut result = EvalResult::Nil;
    for arg in args.iter().rev() {
        let val = eval_with_env(arg, env)?;
        result = EvalResult::Cons(Rc::new(RefCell::new(val)), Rc::new(RefCell::new(result)));
    }
    Ok(result)
}

fn eval_length(args: &[ASTNode], env: &mut HashMap<String, EvalResult>) -> Result<EvalResult, String> {
    if args.len() != 1 {
        return Err("length requires 1 argument".to_string());
    }

    let list = eval_with_env(&args[0], env)?;
    let len = count_list_length(&list);
    Ok(EvalResult::Fixnum(len))
}

fn count_list_length(list: &EvalResult) -> i64 {
    let mut len = 0;
    let mut current = list.clone();

    loop {
        let next = match &current {
            EvalResult::Nil => return len,
            EvalResult::Cons(_, cdr) => {
                len += 1;
                cdr.borrow().clone()
            }
            _ => return len, // Improper list
        };
        current = next;
    }
}

fn eval_nth(args: &[ASTNode], env: &mut HashMap<String, EvalResult>) -> Result<EvalResult, String> {
    if args.len() != 2 {
        return Err("nth requires 2 arguments".to_string());
    }

    let n = match eval_with_env(&args[0], env)? {
        EvalResult::Fixnum(i) => i,
        _ => return Err("nth: index must be a number".to_string()),
    };

    let list = eval_with_env(&args[1], env)?;
    nth_element(&list, n).ok_or_else(|| "nth: index out of bounds".to_string())
}

fn nth_element(list: &EvalResult, n: i64) -> Option<EvalResult> {
    if n < 0 {
        return None;
    }

    let mut current = list.clone();
    let mut index = 0;

    loop {
        let next = match &current {
            EvalResult::Nil => return None,
            EvalResult::Cons(car, cdr) => {
                if index == n {
                    return Some(car.borrow().clone());
                }
                index += 1;
                cdr.borrow().clone()
            }
            _ => return None,
        };
        current = next;
    }
}

fn eval_append(args: &[ASTNode], env: &mut HashMap<String, EvalResult>) -> Result<EvalResult, String> {
    if args.is_empty() {
        return Ok(EvalResult::Nil);
    }

    let mut lists: Vec<EvalResult> = Vec::new();
    for arg in args {
        lists.push(eval_with_env(arg, env)?);
    }

    // Append all lists
    let mut result = EvalResult::Nil;
    for list in lists.iter().rev() {
        result = append_two_lists(list, &result);
    }

    Ok(result)
}

fn append_two_lists(list1: &EvalResult, list2: &EvalResult) -> EvalResult {
    match list1 {
        EvalResult::Nil => list2.clone(),
        EvalResult::Cons(car, cdr) => {
            let cdr_val = cdr.borrow();
            let rest = append_two_lists(&cdr_val, list2);
            EvalResult::Cons(car.clone(), Rc::new(RefCell::new(rest)))
        }
        _ => list2.clone(),
    }
}

fn eval_reverse(args: &[ASTNode], env: &mut HashMap<String, EvalResult>) -> Result<EvalResult, String> {
    if args.len() != 1 {
        return Err("reverse requires 1 argument".to_string());
    }

    let list = eval_with_env(&args[0], env)?;
    Ok(reverse_list(&list))
}

fn reverse_list(list: &EvalResult) -> EvalResult {
    let mut result = EvalResult::Nil;
    let mut current = list.clone();

    loop {
        let next = match &current {
            EvalResult::Nil => return result,
            EvalResult::Cons(car, cdr) => {
                result = EvalResult::Cons(car.clone(), Rc::new(RefCell::new(result)));
                cdr.borrow().clone()
            }
            _ => return result,
        };
        current = next;
    }
}

fn eval_mapcar(args: &[ASTNode], env: &mut HashMap<String, EvalResult>) -> Result<EvalResult, String> {
    if args.len() < 2 {
        return Err("mapcar requires at least 2 arguments".to_string());
    }

    let func = eval_with_env(&args[0], env)?;
    let list = eval_with_env(&args[1], env)?;

    let mut results = Vec::new();
    let mut current = list.clone();

    loop {
        let next = match &current {
            EvalResult::Nil => break,
            EvalResult::Cons(car, cdr) => {
                // Call function with car
                let result = apply_function(&func, &[car.borrow().clone()], env)?;
                results.push(result);
                cdr.borrow().clone()
            }
            _ => return Err("mapcar: not a proper list".to_string()),
        };
        current = next;
    }

    // Build result list
    let mut result = EvalResult::Nil;
    for item in results.iter().rev() {
        result = EvalResult::Cons(Rc::new(RefCell::new(item.clone())), Rc::new(RefCell::new(result)));
    }

    Ok(result)
}

fn apply_function(
    func: &EvalResult,
    args: &[EvalResult],
    env: &mut HashMap<String, EvalResult>,
) -> Result<EvalResult, String> {
    match func {
        EvalResult::Lambda { params, body, env: closure_env } => {
            if params.len() != args.len() {
                return Err(format!("Expected {} arguments, got {}", params.len(), args.len()));
            }

            let mut lambda_env = closure_env.clone();

            // Merge calling environment for recursive functions
            for (key, value) in env.iter() {
                if !lambda_env.contains_key(key) {
                    lambda_env.insert(key.clone(), value.clone());
                }
            }

            // Bind parameters
            for (param, arg) in params.iter().zip(args.iter()) {
                lambda_env.insert(param.clone(), arg.clone());
            }

            // Evaluate body
            let mut result = EvalResult::Nil;
            for expr in body {
                result = eval_with_env(expr, &mut lambda_env)?;
            }
            Ok(result)
        }
        _ => Err("mapcar: first argument must be a function".to_string()),
    }
}

fn eval_member(args: &[ASTNode], env: &mut HashMap<String, EvalResult>) -> Result<EvalResult, String> {
    if args.len() != 2 {
        return Err("member requires 2 arguments".to_string());
    }

    let item = eval_with_env(&args[0], env)?;
    let list = eval_with_env(&args[1], env)?;

    let mut current = list.clone();

    loop {
        match &current {
            EvalResult::Nil => return Ok(EvalResult::Nil),
            EvalResult::Cons(car, cdr) => {
                let car_val = car.borrow().clone();
                let cdr_val = cdr.borrow().clone();
                if values_equal(&item, &car_val) {
                    return Ok(current.clone());
                }
                current = cdr_val;
            }
            _ => return Ok(EvalResult::Nil),
        }
    }
}

fn eval_assoc(args: &[ASTNode], env: &mut HashMap<String, EvalResult>) -> Result<EvalResult, String> {
    if args.len() != 2 {
        return Err("assoc requires 2 arguments".to_string());
    }

    let key = eval_with_env(&args[0], env)?;
    let alist = eval_with_env(&args[1], env)?;

    let mut current = alist.clone();

    loop {
        match &current {
            EvalResult::Nil => return Ok(EvalResult::Nil),
            EvalResult::Cons(car, cdr) => {
                // Check if car is a cons cell (key . value)
                let car_val = car.borrow().clone();
                let cdr_val = cdr.borrow().clone();
                if let EvalResult::Cons(pair_car, _) = &car_val {
                    let pair_car_val = pair_car.borrow().clone();
                    if values_equal(&key, &pair_car_val) {
                        return Ok(car_val.clone());
                    }
                }
                current = cdr_val;
            }
            _ => return Ok(EvalResult::Nil),
        }
    }
}

