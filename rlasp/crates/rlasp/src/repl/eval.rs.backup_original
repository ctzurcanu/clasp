    let val = eval_with_env(&args[0], env)?;
    match val {
        EvalResult::Cons(_, cdr) => {
            let cdr_val = cdr.borrow();
            match &*cdr_val {
                EvalResult::Cons(car2, _) => Ok(car2.borrow().clone()),
                _ => Err("cadr: not enough elements".to_string()),
