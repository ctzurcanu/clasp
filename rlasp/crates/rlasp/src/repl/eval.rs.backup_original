fn eval_eql(args: &[ASTNode], env: &mut HashMap<String, EvalResult>) -> Result<EvalResult, String> {
    if args.len() != 2 {
        return Err("eql requires 2 arguments".to_string());
    }

    let first = eval_with_env(&args[0], env)?;
    let second = eval_with_env(&args[1], env)?;

    // eql is like eq but also compares numbers and characters by value
    // For cons cells, it checks identity (pointer equality)
    match (&first, &second) {
        (EvalResult::Cons(car1, cdr1), EvalResult::Cons(car2, cdr2)) => {
            // Check if they point to the same cons cell
            if Rc::ptr_eq(car1, car2) && Rc::ptr_eq(cdr1, cdr2) {
                Ok(EvalResult::Bool(true))
            } else {
                Ok(EvalResult::Nil)
            }
        }
        _ => {
            // For other types, use structural equality
            if structural_equal(&first, &second) {
                Ok(EvalResult::Bool(true))
            } else {
                Ok(EvalResult::Nil)
            }
        }
    }
}

