(load "clisp/in_work/regression-tests/framework.lisp")
(in-package #:clasp-tests)
(defun hash-table-basics (table)
  (values (hash-table-p table)
          (hash-table-size table)
          (hash-table-count table)
          (typep (hash-table-rehash-size table) '(real 1))
          (typep (hash-table-rehash-threshold table) '(real 0 1))
          (hash-table-test table)
          (ext:hash-table-weakness table)
          (multiple-value-list (gethash :key table))))
(format t "weakness key => ~S~%" (ext:hash-table-weakness (make-hash-table :size 128 :weakness :key)))
(format t "basics key => ~S~%" (multiple-value-list (hash-table-basics (make-hash-table :size 128 :weakness :key))))
